# Migration role + direct (non-pooler) connection. Never expose to browser.
DIRECT_DATABASE_URL=postgresql://migration-user:password@database-host/app?sslmode=verify-full
# Provision only in a dedicated app database. Generate 32 random bytes in base64url.
RUNTIME_ROLE=sixtysix_runtime_preview
RUNTIME_ROLE_PASSWORD=
# Runtime probe only; do not reuse the migration owner.
APP_DATABASE_URL=postgresql://sixtysix_runtime_preview:password@database-host/app?sslmode=verify-full

# Dedicated worker only; never put this URL in the web app environment.
WORKER_DATABASE_URL=
# Admin-only role provisioning input. Existing passwords are not changed.
WORKER_ROLE=sixtysix_worker_preview
WORKER_ROLE_PASSWORD=
