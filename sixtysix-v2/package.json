{
  "name": "sixtysix-v2",
  "private": true,
  "type": "module",
  "description": "육십육 V2. 도메인·시뮬레이터·Clock 위에 React 화면을 올린다.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run typecheck:server && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:auth-core": "node --import tsx --test ../backend/scripts/test-auth-core.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc --project tsconfig.server.json",
    "dev:api": "node --env-file-if-exists=.env --import tsx server/dev.ts"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.1",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^30.0.1",
    "tsx": "4.23.15",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@vercel/functions": "3.9.11",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3"
  },
  "engines": {
    "node": "22.x"
  }
}
