# Server only. Never prefix database/auth secrets with VITE_.
# Use a separate Neon branch/database per Preview and Production environment.
# Explicit SQL-created runtime role. DATABASE_URL is never used as a fallback.
APP_DATABASE_URL=postgresql://sixtysix_runtime_preview:password@database-host/app?sslmode=verify-full
# For local API dev: copy to .env and run npm run dev:api
PORT=3001
# Anonymous browser CSRF context. Generate a random secret of at least 32 chars.
APP_ORIGIN=http://localhost:5173
AUTH_CONTEXT_SECRET=
# Independent random server secret (32+ chars) for OTP HMAC and rate-limit keys.
AUTH_OTP_SECRET=
# No fallback/mock sender. Configure a verified sender before real email tests.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Kakao REST API key + activated client secret. Register exactly
# ${APP_ORIGIN}/v1/auth/kakao/callback in the Kakao developer console.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
